# Gemini & NVIDIA AI Models Configuration
GEMINI_API_KEY="your_gemini_api_key_here"
NVIDIA_API_KEY="your_nvidia_api_key_here"

# MySQL Database Configuration
# Format: mysql+pymysql://<user>:<password>@<host>:<port>/<database_name>?charset=utf8mb4
DATABASE_URL="mysql+pymysql://root:root@localhost:3306/finai_db?charset=utf8mb4"

# Optional Individual MySQL connection properties:
# DB_USER="root"
# DB_PASSWORD="your_password"
# DB_HOST="localhost"
# DB_PORT="3306"
# DB_NAME="finai_db"
